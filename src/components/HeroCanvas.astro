---
---

<div class="hero-canvas" aria-hidden="true">
	<canvas id="hero-canvas"></canvas>
</div>

<script>
	import * as THREE from 'three';

	const canvas = document.getElementById('hero-canvas') as HTMLCanvasElement | null;
	const container = canvas?.parentElement;
	if (!canvas || !container) throw new Error('hero canvas not found');

	const isMobile = window.matchMedia('(max-width: 767px)').matches;
	const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

	const scene = new THREE.Scene();
	const camera = new THREE.PerspectiveCamera(55, 1, 0.1, 100);
	camera.position.set(0, 0, 8);

	const renderer = new THREE.WebGLRenderer({ canvas, alpha: true, antialias: !isMobile });
	renderer.setPixelRatio(Math.min(window.devicePixelRatio, isMobile ? 1 : 2));

	const copper = new THREE.Color('#e58a45');
	const copperDim = new THREE.Color('#c96f31');

	// Orbital group — icosahedron + orbital particles, shifted to right
	const orbitalGroup = new THREE.Group();
	orbitalGroup.position.set(isMobile ? 0 : 3.5, 0.5, 0);

	const core = new THREE.Mesh(
		new THREE.IcosahedronGeometry(1.3, 1),
		new THREE.MeshBasicMaterial({ color: copper, wireframe: true, transparent: true, opacity: 0.18 }),
	);
	orbitalGroup.add(core);

	const innerCore = new THREE.Mesh(
		new THREE.IcosahedronGeometry(0.8, 0),
		new THREE.MeshBasicMaterial({ color: copperDim, wireframe: true, transparent: true, opacity: 0.09 }),
	);
	orbitalGroup.add(innerCore);

	const ORBITAL_COUNT = 26;
	const orbitalPositions: THREE.Vector3[] = [];
	for (let i = 0; i < ORBITAL_COUNT; i++) {
		const r = 2 + Math.random();
		const theta = Math.random() * Math.PI * 2;
		const phi = Math.acos(Math.random() * 2 - 1);
		orbitalPositions.push(
			new THREE.Vector3(
				r * Math.sin(phi) * Math.cos(theta),
				r * Math.sin(phi) * Math.sin(theta),
				r * Math.cos(phi),
			),
		);
	}

	orbitalGroup.add(
		new THREE.Points(
			new THREE.BufferGeometry().setFromPoints(orbitalPositions),
			new THREE.PointsMaterial({ color: copper, size: 0.04, transparent: true, opacity: 0.3 }),
		),
	);

	const linePositions: number[] = [];
	for (let i = 0; i < orbitalPositions.length; i++) {
		for (let j = i + 1; j < orbitalPositions.length; j++) {
			if (orbitalPositions[i].distanceTo(orbitalPositions[j]) < 1.5) {
				linePositions.push(
					orbitalPositions[i].x, orbitalPositions[i].y, orbitalPositions[i].z,
					orbitalPositions[j].x, orbitalPositions[j].y, orbitalPositions[j].z,
				);
			}
		}
	}
	const lineGeo = new THREE.BufferGeometry();
	lineGeo.setAttribute('position', new THREE.Float32BufferAttribute(linePositions, 3));
	orbitalGroup.add(
		new THREE.LineSegments(
			lineGeo,
			new THREE.LineBasicMaterial({ color: copperDim, transparent: true, opacity: 0.06 }),
		),
	);

	// Ambient particle field spread across the full canvas width
	const AMBIENT_COUNT = isMobile ? 22 : 65;
	const ambientPos: number[] = [];
	for (let i = 0; i < AMBIENT_COUNT; i++) {
		ambientPos.push(
			(Math.random() - 0.5) * 18,
			(Math.random() - 0.5) * 10,
			(Math.random() - 0.5) * 6,
		);
	}
	const ambientGeo = new THREE.BufferGeometry();
	ambientGeo.setAttribute('position', new THREE.Float32BufferAttribute(ambientPos, 3));
	const ambientDots = new THREE.Points(
		ambientGeo,
		new THREE.PointsMaterial({ color: copper, size: 0.025, transparent: true, opacity: 0.18 }),
	);

	scene.add(ambientDots, orbitalGroup);

	function resize() {
		if (!container || !canvas) return;
		const { clientWidth, clientHeight } = container;
		camera.aspect = clientWidth / clientHeight;
		camera.updateProjectionMatrix();
		renderer.setSize(clientWidth, clientHeight, false);
	}
	resize();
	window.addEventListener('resize', resize);

	let mouseX = 0;
	let mouseY = 0;
	let lerpX = 0;
	let lerpY = 0;

	if (!prefersReducedMotion && !isMobile) {
		window.addEventListener('mousemove', (e) => {
			mouseX = (e.clientX / window.innerWidth - 0.5) * 2;
			mouseY = (e.clientY / window.innerHeight - 0.5) * 2;
		});
	}

	let frameId = 0;
	let visible = true;
	const observer = new IntersectionObserver(([entry]) => {
		visible = entry.isIntersecting;
	});
	observer.observe(container);

	function tick(time: number) {
		frameId = requestAnimationFrame(tick);
		if (!visible) return;

		const t = time * 0.00005;

		lerpX += (mouseX - lerpX) * 0.04;
		lerpY += (mouseY - lerpY) * 0.04;

		orbitalGroup.rotation.y = t + lerpX * 0.5;
		orbitalGroup.rotation.x = Math.sin(t * 0.5) * 0.12 - lerpY * 0.35;

		ambientDots.rotation.y = t * 0.08;

		renderer.render(scene, camera);
	}

	if (prefersReducedMotion) {
		orbitalGroup.rotation.y = 0.4;
		orbitalGroup.rotation.x = 0.1;
		resize();
		renderer.render(scene, camera);
	} else {
		frameId = requestAnimationFrame(tick);
	}

	document.addEventListener('astro:before-swap', () => cancelAnimationFrame(frameId), { once: true });
</script>

<style>
	.hero-canvas {
		position: absolute;
		inset: 0;
		z-index: 0;
		pointer-events: none;
		/* show only left and right side strips */
		mask-image: linear-gradient(to right,
			transparent 0%,
			black 5%,
			black 20%,
			transparent 27%,
			transparent 73%,
			black 80%,
			black 95%,
			transparent 100%
		);
		-webkit-mask-image: linear-gradient(to right,
			transparent 0%,
			black 5%,
			black 20%,
			transparent 27%,
			transparent 73%,
			black 80%,
			black 95%,
			transparent 100%
		);
	}

	.hero-canvas canvas {
		width: 100%;
		height: 100%;
		display: block;
	}

	@media (max-width: 767px) {
		.hero-canvas {
			display: none;
		}
	}
</style>
