---
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';

interface Project {
  name: string;
  url: string;
  category: string;
  screenshot: string;
}

interface Props {
  projects: Project[];
  lang: Lang;
}

const { projects, lang } = Astro.props;
const t = useTranslations(lang);
const BASE_URL = import.meta.env.BASE_URL.replace(/\/$/, '');

const carouselData = projects.map(p => ({
  name: p.name,
  url: p.url,
  categoryLabel: t(`projects.tab.${p.category}` as any),
  screenshot: `${BASE_URL}/screenshots/${p.screenshot}.webp`,
}));

const prevLabel = lang === 'pt' ? 'Anterior' : 'Previous';
const nextLabel = lang === 'pt' ? 'Próximo' : 'Next';
const viewLabel = lang === 'pt' ? 'Ver Projeto' : 'View Project';
---

<div
  class="carousel-root relative w-full select-none"
  data-projects={JSON.stringify(carouselData)}
  tabindex="0"
>
  <canvas class="carousel-canvas block w-full" aria-hidden="true"></canvas>

  <button class="carousel-btn carousel-btn--prev" aria-label={prevLabel}>
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
      <polyline points="15 18 9 12 15 6"/>
    </svg>
  </button>
  <button class="carousel-btn carousel-btn--next" aria-label={nextLabel}>
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
      <polyline points="9 18 15 12 9 6"/>
    </svg>
  </button>

  <div class="mt-5 flex flex-col items-center gap-3">
    <div class="flex gap-2">
      {carouselData.map((_, i) => (
        <button
          class="carousel-dot"
          data-index={i}
          aria-label={`${lang === 'pt' ? 'Projeto' : 'Project'} ${i + 1}`}
        />
      ))}
    </div>
    <span class="carousel-category font-mono text-xs uppercase tracking-wider text-copper-400"></span>
    <div class="flex flex-wrap items-center justify-center gap-3">
      <span class="carousel-title font-display text-xl font-semibold tracking-tight text-paper"></span>
      <a
        class="carousel-link rounded-full border border-ink-600 px-4 py-1.5 font-mono text-xs uppercase tracking-wider text-paper transition-colors duration-150 hover:border-copper-500 hover:text-copper-400"
        target="_blank"
        rel="noopener noreferrer"
        href="#"
      >
        {viewLabel} →
      </a>
    </div>
  </div>
</div>

<script>
  import * as THREE from 'three';

  interface CarouselProject {
    name: string;
    url: string;
    categoryLabel: string;
    screenshot: string;
  }

  interface CardEntry {
    group: THREE.Group;
    imgMat: THREE.MeshBasicMaterial;
    frameMat: THREE.MeshBasicMaterial;
  }

  document.querySelectorAll<HTMLElement>('.carousel-root').forEach(root => {
    (async () => {
      const canvasEl = root.querySelector<HTMLCanvasElement>('.carousel-canvas')!;
      const prevBtn = root.querySelector<HTMLButtonElement>('.carousel-btn--prev')!;
      const nextBtn = root.querySelector<HTMLButtonElement>('.carousel-btn--next')!;
      const dots = Array.from(root.querySelectorAll<HTMLButtonElement>('.carousel-dot'));
      const categoryEl = root.querySelector<HTMLElement>('.carousel-category')!;
      const titleEl = root.querySelector<HTMLElement>('.carousel-title')!;
      const linkEl = root.querySelector<HTMLAnchorElement>('.carousel-link')!;

      const projects: CarouselProject[] = JSON.parse(root.dataset.projects!);
      // Fisher-Yates shuffle — different order every page load
      for (let i = projects.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [projects[i], projects[j]] = [projects[j], projects[i]];
      }
      const COUNT = projects.length;

      const scene = new THREE.Scene();
      const camera = new THREE.PerspectiveCamera(68, 1, 0.1, 100);
      camera.position.z = 3.5;

      const renderer = new THREE.WebGLRenderer({ canvas: canvasEl, alpha: true, antialias: true });
      renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));

      // Card dimensions (1.6:1 matches 1280×800 screenshots)
      const CW = 4.8;
      const CH = 3.0;
      const FP = 0.1;

      const inkColor = new THREE.Color('#212b4a');
      const copperColor = new THREE.Color('#e58a45');

      // Load all textures in parallel
      const loader = new THREE.TextureLoader();
      const textures = await Promise.all(
        projects.map(p => loader.loadAsync(p.screenshot).catch(() => {
          // Fallback: 1×1 dark texture if screenshot fails to load
          const fb = new THREE.DataTexture(new Uint8Array([23, 31, 56, 255]), 1, 1);
          fb.needsUpdate = true;
          return fb;
        }))
      );
      textures.forEach(tex => {
        if ('colorSpace' in tex) tex.colorSpace = THREE.SRGBColorSpace;
      });

      const cards: CardEntry[] = textures.map((texture) => {
        const imgMat = new THREE.MeshBasicMaterial({ map: texture, transparent: true });
        const frameMat = new THREE.MeshBasicMaterial({ color: inkColor.clone(), transparent: true });

        const img = new THREE.Mesh(new THREE.PlaneGeometry(CW, CH), imgMat);
        const frame = new THREE.Mesh(
          new THREE.PlaneGeometry(CW + FP * 2, CH + FP * 2),
          frameMat,
        );
        frame.position.z = -0.005;

        const group = new THREE.Group();
        group.add(frame, img);
        scene.add(group);

        return { group, imgMat, frameMat };
      });

      // State
      let currentIndex = 0;
      let animIndex = 0;
      let pointerDown = false;
      let pointerStartX = 0;
      let pointerDelta = 0;

      function wrappedOffset(i: number, center: number): number {
        let off = i - center;
        while (off > COUNT / 2) off -= COUNT;
        while (off < -COUNT / 2) off += COUNT;
        return off;
      }

      function updateCards(idx: number) {
        cards.forEach(({ group, imgMat, frameMat }, i) => {
          const off = wrappedOffset(i, idx);
          const abs = Math.abs(off);
          const sign = off >= 0 ? 1 : -1;
          const cappedAbs = Math.min(abs, 2.5);

          group.position.x = sign * cappedAbs * 2.9;
          group.position.z = -cappedAbs * 0.5;
          group.rotation.y = -sign * Math.min(abs, 1) * (Math.PI / 2.5);
          group.scale.setScalar(Math.max(0.72, 1 - Math.min(abs, 2) * 0.14));

          const opacity = Math.max(0.38, 1 - Math.min(abs, 2) * 0.28);
          imgMat.opacity = opacity;
          frameMat.opacity = opacity;

          const copperFactor = Math.max(0, 1 - abs * 1.6);
          frameMat.color.lerpColors(inkColor, copperColor, copperFactor * 0.6);
        });
      }

      function resize() {
        const w = root.clientWidth;
        const h = Math.min(Math.round(window.innerHeight * 0.72), Math.max(380, Math.round(w * 0.6)));
        canvasEl.style.height = `${h}px`;
        camera.aspect = w / h;
        camera.updateProjectionMatrix();
        renderer.setSize(w, h, false);
      }
      resize();
      window.addEventListener('resize', resize);

      // Update info panel + dots
      let lastInfoIdx = -1;
      function updateInfo(animIdx: number) {
        const idx = ((Math.round(animIdx) % COUNT) + COUNT) % COUNT;
        if (idx === lastInfoIdx) return;
        lastInfoIdx = idx;
        categoryEl.textContent = projects[idx].categoryLabel;
        titleEl.textContent = projects[idx].name;
        linkEl.href = projects[idx].url;
        dots.forEach((dot, i) => dot.classList.toggle('active', i === idx));
      }
      updateInfo(0);

      // Animation loop
      let raf = 0;
      let isVisible = true;
      const obs = new IntersectionObserver(([e]) => { isVisible = e.isIntersecting; });
      obs.observe(root);

      function tick() {
        raf = requestAnimationFrame(tick);
        if (!isVisible) return;

        const target = currentIndex + (pointerDown ? -pointerDelta / 220 : 0);
        animIndex += (target - animIndex) * 0.1;

        updateCards(animIndex);
        updateInfo(animIndex);
        renderer.render(scene, camera);
      }
      tick();

      // Go to index (taking shortest wrapped path)
      function goTo(idx: number) {
        const next = ((idx % COUNT) + COUNT) % COUNT;
        let diff = next - animIndex;
        while (diff > COUNT / 2) diff -= COUNT;
        while (diff < -COUNT / 2) diff += COUNT;
        animIndex = next - diff;
        currentIndex = next;
      }

      prevBtn.addEventListener('click', () => goTo(currentIndex - 1));
      nextBtn.addEventListener('click', () => goTo(currentIndex + 1));
      dots.forEach((dot, i) => dot.addEventListener('click', () => goTo(i)));

      root.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowLeft') { e.preventDefault(); goTo(currentIndex - 1); }
        if (e.key === 'ArrowRight') { e.preventDefault(); goTo(currentIndex + 1); }
      });

      // Pointer drag + tap
      canvasEl.style.cursor = 'grab';
      canvasEl.addEventListener('pointerdown', (e) => {
        pointerDown = true;
        pointerStartX = e.clientX;
        pointerDelta = 0;
        canvasEl.setPointerCapture(e.pointerId);
        canvasEl.style.cursor = 'grabbing';
      });
      canvasEl.addEventListener('pointermove', (e) => {
        if (pointerDown) pointerDelta = e.clientX - pointerStartX;
      });
      canvasEl.addEventListener('pointerup', () => {
        if (!pointerDown) return;
        if (Math.abs(pointerDelta) > 55) {
          goTo(pointerDelta > 0 ? currentIndex - 1 : currentIndex + 1);
        } else if (Math.abs(pointerDelta) < 8) {
          const idx = ((Math.round(animIndex) % COUNT) + COUNT) % COUNT;
          window.open(projects[idx].url, '_blank', 'noopener,noreferrer');
        }
        pointerDown = false;
        pointerDelta = 0;
        canvasEl.style.cursor = 'grab';
      });

      document.addEventListener('astro:before-swap', () => {
        cancelAnimationFrame(raf);
        obs.disconnect();
        window.removeEventListener('resize', resize);
      }, { once: true });
    })();
  });
</script>

<style>
  .carousel-btn {
    position: absolute;
    top: 50%;
    transform: translateY(-75%);
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 9999px;
    border: 1px solid var(--color-ink-600);
    background: color-mix(in srgb, var(--color-ink-950) 78%, transparent);
    color: var(--color-paper-muted);
    cursor: pointer;
    transition: border-color 0.15s, color 0.15s;
    backdrop-filter: blur(4px);
    z-index: 10;
  }
  .carousel-btn:hover {
    border-color: color-mix(in srgb, var(--color-copper-500) 60%, transparent);
    color: var(--color-copper-400);
  }
  .carousel-btn--prev { left: 0.5rem; }
  .carousel-btn--next { right: 0.5rem; }

  .carousel-dot {
    height: 0.375rem;
    width: 0.375rem;
    border-radius: 9999px;
    background-color: var(--color-ink-600);
    border: none;
    padding: 0;
    cursor: pointer;
    transition: background-color 0.2s, width 0.25s var(--ease-out);
    flex-shrink: 0;
  }
  .carousel-dot.active {
    background-color: var(--color-copper-500);
    width: 1.5rem;
  }
</style>
